{
  "name": "warpengine-toolbox",
  "displayName": "WarpEngine Toolbox",
  "description": "%description%",
  "version": "1.3.0",
  "publisher": "TeletypeGames",
  "license": "MIT",
  "author": "Teletype Games",
  "homepage": "https://git.teletypegames.org/tools/warp-engine-toolbox",
  "repository": {
    "type": "git",
    "url": "https://git.teletypegames.org/tools/warp-engine-toolbox"
  },
  "bugs": {
    "url": "https://git.teletypegames.org/tools/warp-engine-toolbox/issues"
  },
  "qna": false,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f1720",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22"
  },
  "categories": [
    "Other",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "warpengine",
    "gamedev",
    "retro",
    "c64",
    "tic-80",
    "godot",
    "catalog"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "workspaceContains:metadata.json",
    "workspaceContains:.woodpecker.yaml",
    "workspaceContains:.gitlab-ci.yml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "warpengine.newGame",
        "title": "%command.newGame%",
        "category": "WarpEngine",
        "icon": "$(add)"
      },
      {
        "command": "warpengine.addToProject",
        "title": "%command.addToProject%",
        "category": "WarpEngine"
      },
      {
        "command": "warpengine.connect",
        "title": "%command.connect%",
        "category": "WarpEngine",
        "icon": "$(plug)"
      },
      {
        "command": "warpengine.signIn",
        "title": "%command.signIn%",
        "category": "WarpEngine",
        "icon": "$(sign-in)"
      },
      {
        "command": "warpengine.signOut",
        "title": "%command.signOut%",
        "category": "WarpEngine"
      },
      {
        "command": "warpengine.selectHost",
        "title": "%command.selectHost%",
        "category": "WarpEngine",
        "icon": "$(server)"
      },
      {
        "command": "warpengine.previewPipeline",
        "title": "%command.previewPipeline%",
        "category": "WarpEngine"
      },
      {
        "command": "warpengine.play",
        "title": "%command.play%",
        "category": "WarpEngine",
        "icon": "$(play)"
      },
      {
        "command": "warpengine.buildLikeCi",
        "title": "%command.buildLikeCi%",
        "category": "WarpEngine"
      },
      {
        "command": "warpengine.checkPublish",
        "title": "%command.checkPublish%",
        "category": "WarpEngine",
        "icon": "$(checklist)"
      },
      {
        "command": "warpengine.release",
        "title": "%command.release%",
        "category": "WarpEngine",
        "icon": "$(rocket)"
      },
      {
        "command": "warpengine.editMetadata",
        "title": "%command.editMetadata%",
        "category": "WarpEngine",
        "icon": "$(edit)"
      },
      {
        "command": "warpengine.refresh",
        "title": "%command.refresh%",
        "category": "WarpEngine",
        "icon": "$(refresh)"
      },
      {
        "command": "warpengine.openUrl",
        "title": "%command.openUrl%",
        "category": "WarpEngine",
        "icon": "$(link-external)"
      },
      {
        "command": "warpengine.triggerPipeline",
        "title": "%command.triggerPipeline%",
        "category": "WarpEngine",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "warpengine.editSoftwareField",
        "title": "%command.editSoftwareField%",
        "category": "WarpEngine",
        "icon": "$(edit)"
      },
      {
        "command": "warpengine.showChecklist",
        "title": "%command.showChecklist%",
        "category": "WarpEngine",
        "icon": "$(checklist)"
      },
      {
        "command": "warpengine.showStatistics",
        "title": "%command.showStatistics%",
        "category": "WarpEngine",
        "icon": "$(graph)"
      },
      {
        "command": "warpengine.copyLink",
        "title": "%command.copyLink%",
        "category": "WarpEngine",
        "icon": "$(copy)"
      },
      {
        "command": "warpengine.openPlatformDocs",
        "title": "%command.openPlatformDocs%",
        "category": "WarpEngine",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "warpengine.newGame",
          "when": "view == warpengine.project",
          "group": "navigation@1"
        },
        {
          "command": "warpengine.refresh",
          "when": "view == warpengine.project || view == warpengine.catalog",
          "group": "navigation@9"
        },
        {
          "command": "warpengine.selectHost",
          "when": "view == warpengine.catalog",
          "group": "navigation@2"
        },
        {
          "command": "warpengine.signIn",
          "when": "view == warpengine.catalog && warpengine.hasHost && !warpengine.signedIn",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "warpengine.openPlatformDocs",
          "when": "viewItem =~ /docs/",
          "group": "inline"
        },
        {
          "command": "warpengine.openUrl",
          "when": "viewItem =~ /link/",
          "group": "inline"
        },
        {
          "command": "warpengine.copyLink",
          "when": "viewItem =~ /link/",
          "group": "inline"
        },
        {
          "command": "warpengine.triggerPipeline",
          "when": "viewItem =~ /pipeline/",
          "group": "inline"
        },
        {
          "command": "warpengine.editSoftwareField",
          "when": "viewItem =~ /field/",
          "group": "inline"
        },
        {
          "command": "warpengine.showChecklist",
          "when": "viewItem =~ /release/",
          "group": "inline"
        },
        {
          "command": "warpengine.showStatistics",
          "when": "viewItem =~ /software/",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "warpengine.openUrl",
          "when": "false"
        },
        {
          "command": "warpengine.triggerPipeline",
          "when": "false"
        },
        {
          "command": "warpengine.editSoftwareField",
          "when": "false"
        },
        {
          "command": "warpengine.showChecklist",
          "when": "false"
        },
        {
          "command": "warpengine.showStatistics",
          "when": "false"
        },
        {
          "command": "warpengine.refresh",
          "when": "false"
        },
        {
          "command": "warpengine.copyLink",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "warpengine.editMetadata",
          "when": "resourceFilename == metadata.json",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "warpengine",
          "title": "%viewsContainer.warpengine%",
          "icon": "media/warp.svg"
        }
      ]
    },
    "views": {
      "warpengine": [
        {
          "id": "warpengine.project",
          "name": "%view.project%"
        },
        {
          "id": "warpengine.catalog",
          "name": "%view.catalog%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "warpengine.project",
        "contents": "%welcome.project%"
      },
      {
        "view": "warpengine.catalog",
        "contents": "%welcome.catalog.host%",
        "when": "!warpengine.hasHost"
      },
      {
        "view": "warpengine.catalog",
        "contents": "%welcome.catalog.signIn%",
        "when": "warpengine.hasHost && !warpengine.signedIn"
      }
    ],
    "authentication": [
      {
        "id": "warpengine",
        "label": "WarpEngine"
      }
    ],
    "customEditors": [
      {
        "viewType": "warpengine.metadata",
        "displayName": "%customEditor.metadata%",
        "selector": [
          {
            "filenamePattern": "metadata.json"
          }
        ],
        "priority": "option"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "metadata.json",
        "url": "warpengine-schema://current/metadata.schema.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "warpengine",
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "string",
            "description": "%task.target%"
          },
          "ci": {
            "type": "boolean",
            "description": "%task.ci%"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "warp-acme",
        "owner": "warpengine",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(Error|Warning|Serious error) - File ([^,]+), line (\\d+) \\([^)]*\\): (.*)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "message": 4
        }
      },
      {
        "name": "warp-cc65",
        "owner": "warpengine",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^([^(\\s]+)\\((\\d+)\\): (Error|Warning): (.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      },
      {
        "name": "warp-gcc",
        "owner": "warpengine",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^([^:\\s][^:]*):(\\d+):(\\d+):\\s+(?:(error|warning|note):\\s+)?(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      {
        "name": "warp-lua",
        "owner": "warpengine",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(?:lua\\S*:\\s+)?([^:\\s]+\\.lua):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      }
    ],
    "configuration": {
      "title": "WarpEngine",
      "properties": {
        "warpengine.url": {
          "type": "string",
          "default": "",
          "format": "uri",
          "markdownDescription": "%config.url%"
        },
        "warpengine.hosts": {
          "type": "array",
          "description": "%config.hosts%",
          "items": {
            "type": "object",
            "required": [
              "name",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "default": []
        },
        "warpengine.checkOnSave": {
          "type": "boolean",
          "description": "%config.checkOnSave%",
          "default": true
        },
        "warpengine.docker": {
          "type": "string",
          "description": "%config.docker%",
          "default": "docker"
        },
        "warpengine.defaultLocation": {
          "type": "string",
          "description": "%config.defaultLocation%",
          "default": ""
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "warpengine",
        "label": "%mcp.label%"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run l10n:check && node scripts/build.mjs --tests && node --test 'dist-test/**/*.test.cjs'",
    "package": "npm run build && vsce package --no-dependencies -o dist/warpengine-toolbox.vsix",
    "vscode:prepublish": "node scripts/build.mjs --production",
    "test:integration": "node scripts/integration.mjs",
    "test:walkthrough": "node scripts/walkthrough.mjs",
    "l10n": "node scripts/l10n.mjs",
    "l10n:check": "node scripts/l10n.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "~1.101.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.30.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0"
  }
}
