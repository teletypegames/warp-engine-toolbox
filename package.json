        "title": "%command.addDevContainer%",
        "category": "WarpEngine"
      },
      {
        "command": "warpengine.startDevContainer",
        "title": "%command.startDevContainer%",
        "category": "WarpEngine",
        "icon": "$(debug-start)"
      },
      {
        "command": "warpengine.stopDevContainer",
        "title": "%command.stopDevContainer%",
        "category": "WarpEngine",
        "icon": "$(debug-stop)"
      },
      {
        "command": "warpengine.connect",
        "title": "%command.connect%",
        "category": "WarpEngine",
