{
  "name": "warpengine-toolbox",
  "displayName": "WarpEngine Toolbox",
  "description": "%description%",
  "version": "1.16.0",
  "publisher": "TeletypeGames",
  "license": "MIT",
  "author": "Teletype Games",
  "homepage": "https://git.teletypegames.org/tools/warp-engine-toolbox",
  "repository": {
    "type": "git",
    "url": "https://git.teletypegames.org/tools/warp-engine-toolbox"
  },
  "bugs": {
    "url": "https://git.teletypegames.org/tools/warp-engine-toolbox/issues"
  },
  "qna": false,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f1720",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22"
  },
  "categories": [
    "Other",
    "Snippets",
    "Linters",
    "Themes"
  ],
  "keywords": [
    "warpengine",
    "gamedev",
    "retro",
    "c64",
    "tic-80",
    "godot",
    "catalog"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "workspaceContains:metadata.json",
    "workspaceContains:.woodpecker.yaml",
    "workspaceContains:.gitlab-ci.yml",
    "onStartupFinished"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Teletype Games - Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/teletype-games-dark.json"
      },
      {
        "label": "Teletype Games - Light",
        "uiTheme": "vs",
        "path": "./themes/teletype-games-light.json"
      },
      {
        "label": "Teletype Games - Retro",
        "uiTheme": "vs-dark",
        "path": "./themes/teletype-games-retro.json"
      },
      {
        "label": "Teletype Games - C64",
        "uiTheme": "vs-dark",
        "path": "./themes/teletype-games-c64.json"
      },
      {
        "label": "Teletype Games - Plus/4",
        "uiTheme": "vs",
        "path": "./themes/teletype-games-plus4.json"
      },
      {
        "label": "Teletype Games - TIC-80",
        "uiTheme": "vs-dark",
        "path": "./themes/teletype-games-tic80.json"
      },
      {
        "label": "Teletype Games - LÖVE",
        "uiTheme": "vs-dark",
        "path": "./themes/teletype-games-love.json"
      },
      {
        "label": "Teletype Games - Phaser",
        "uiTheme": "vs-dark",
        "path": "./themes/teletype-games-phaser.json"
      },
      {
        "label": "Teletype Games - Ebitengine",
        "uiTheme": "vs",
        "path": "./themes/teletype-games-ebitengine.json"
      },
      {
        "label": "Teletype Games - Bevy",
        "uiTheme": "vs-dark",
        "path": "./themes/teletype-games-bevy.json"
      },
      {
        "label": "Teletype Games - Godot",
        "uiTheme": "vs-dark",
        "path": "./themes/teletype-games-godot.json"
      },
      {
        "label": "Teletype Games - DOS",
        "uiTheme": "vs-dark",
        "path": "./themes/teletype-games-dos.json"
      },
      {
        "label": "Teletype Games - Electron",
        "uiTheme": "vs-dark",
        "path": "./themes/teletype-games-electron.json"
      }
