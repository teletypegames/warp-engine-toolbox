      },
      {
        "command": "warpengine.syncDisconnect",
        "title": "%command.syncDisconnect%",
        "category": "WarpEngine",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "warpengine.addImage",
        "title": "%command.addImage%",
        "category": "WarpEngine",
        "icon": "$(add)"
      },
      {
        "command": "warpengine.imageMakeDefault",
        "title": "%command.imageMakeDefault%",
        "category": "WarpEngine",
        "icon": "$(star-empty)"
      },
      {
        "command": "warpengine.imageMoveUp",
        "title": "%command.imageMoveUp%",
        "category": "WarpEngine",
        "icon": "$(arrow-up)"
      },
      {
        "command": "warpengine.imageMoveDown",
        "title": "%command.imageMoveDown%",
        "category": "WarpEngine",
        "icon": "$(arrow-down)"
      },
      {
        "command": "warpengine.imageRemove",
        "title": "%command.imageRemove%",
        "category": "WarpEngine",
        "icon": "$(trash)"
      },
      {
        "command": "warpengine.setupLocalCi",
        "title": "%command.setupLocalCi%",
        "category": "WarpEngine",
        "icon": "$(server-environment)"
      },
      {
        "command": "warpengine.reauthorize",
        "title": "%command.reauthorize%",
        "category": "WarpEngine",
        "icon": "$(key)"
      },
      {
        "command": "warpengine.repairHost",
        "title": "%command.repairHost%",
        "category": "WarpEngine",
        "icon": "$(tools)"
      },
      {
        "command": "warpengine.startDocker",
        "title": "%command.startDocker%",
        "category": "WarpEngine"
      },
      {
        "command": "warpengine.startLocalEngine",
        "title": "%command.startLocalEngine%",
        "category": "WarpEngine",
        "icon": "$(debug-start)"
      },
      {
        "command": "warpengine.reset",
        "title": "%command.reset%",
        "category": "WarpEngine",
        "icon": "$(discard)"
      },
      {
        "command": "warpengine.purgeLocalEngine",
        "title": "%command.purgeLocalEngine%",
        "category": "WarpEngine",
        "icon": "$(trash)"
      },
      {
        "command": "warpengine.deleteSoftware",
        "title": "%command.deleteSoftware%",
        "category": "WarpEngine",
        "icon": "$(trash)"
      },
      {
        "command": "warpengine.deleteRelease",
        "title": "%command.deleteRelease%",
        "category": "WarpEngine",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "warpengine.openDashboard",
          "when": "view == warpengine.project",
          "group": "navigation@2"
        },
        {
          "command": "warpengine.newGame",
          "when": "view == warpengine.project",
          "group": "navigation@1"
        },
        {
          "command": "warpengine.refresh",
          "when": "view == warpengine.project || view == warpengine.catalog || view == warpengine.sync || view == warpengine.servers || view == warpengine.health",
          "group": "navigation@9"
        },
        {
          "command": "warpengine.selectHost",
          "when": "view == warpengine.catalog",
          "group": "navigation@2"
        },
        {
          "command": "warpengine.signIn",
          "when": "view == warpengine.catalog && warpengine.hasHost && !warpengine.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "warpengine.syncTo",
          "when": "view == warpengine.sync && warpengine.localEngine",
          "group": "navigation@1"
        },
        {
          "command": "warpengine.purgeLocalEngine",
          "when": "view == warpengine.servers && warpengine.hasServers && !warpengine.inDevContainer",
          "group": "navigation@2"
        },
        {
          "command": "warpengine.installLocalEngine",
          "when": "view == warpengine.servers && !warpengine.hasServers && !warpengine.inDevContainer",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "warpengine.startLocalEngine",
          "when": "view == warpengine.servers && viewItem =~ /server stopped/",
          "group": "inline"
        },
        {
          "command": "warpengine.startDevContainer",
          "when": "view == warpengine.servers && viewItem == devcontainer",
          "group": "inline"
        },
        {
          "command": "warpengine.stopDevContainer",
          "when": "view == warpengine.servers && viewItem =~ /devcontainer running/",
          "group": "inline"
        },
        {
          "command": "warpengine.openPlatformDocs",
          "when": "viewItem =~ /docs/",
          "group": "inline"
        },
        {
          "command": "warpengine.openUrl",
          "when": "viewItem =~ /link/",
          "group": "inline"
        },
        {
          "command": "warpengine.copyLink",
          "when": "viewItem =~ /link/",
          "group": "inline"
        },
        {
          "command": "warpengine.triggerPipeline",
          "when": "viewItem =~ /pipeline/",
          "group": "inline"
        },
        {
          "command": "warpengine.editSoftwareField",
          "when": "viewItem =~ /field/",
          "group": "inline"
        },
        {
          "command": "warpengine.showChecklist",
          "when": "viewItem =~ /release/",
          "group": "inline"
        },
        {
          "command": "warpengine.showStatistics",
          "when": "viewItem =~ /software/",
          "group": "inline"
        },
        {
          "command": "warpengine.syncPushNow",
          "when": "viewItem == syncPeer",
          "group": "inline"
        },
        {
          "command": "warpengine.syncEditChannels",
          "when": "viewItem == syncPeer",
          "group": "inline"
        },
        {
          "command": "warpengine.syncCheck",
          "when": "viewItem == syncPeer",
          "group": "1_sync@1"
        },
        {
          "command": "warpengine.syncDisconnect",
          "when": "viewItem == syncPeer",
          "group": "2_danger@1"
        },
        {
          "command": "warpengine.addImage",
          "when": "viewItem == images",
          "group": "inline"
        },
        {
          "command": "warpengine.imageMakeDefault",
          "when": "viewItem =~ /image\\b/",
          "group": "inline"
        },
        {
          "command": "warpengine.imageMoveUp",
          "when": "viewItem =~ /image\\b/",
          "group": "1_order@1"
        },
        {
          "command": "warpengine.imageMoveDown",
          "when": "viewItem =~ /image\\b/",
          "group": "1_order@2"
        },
        {
          "command": "warpengine.imageRemove",
          "when": "viewItem =~ /image\\b/",
          "group": "2_danger@1"
        },
        {
          "command": "warpengine.deleteSoftware",
          "when": "view == warpengine.catalog && viewItem =~ /software/",
          "group": "2_danger@1"
        },
        {
          "command": "warpengine.deleteRelease",
          "when": "view == warpengine.catalog && viewItem =~ /release/",
          "group": "2_danger@1"
        }
      ],
      "commandPalette": [
        {
          "command": "warpengine.installLocalEngine",
          "when": "!warpengine.inDevContainer"
        },
        {
          "command": "warpengine.purgeLocalEngine",
          "when": "!warpengine.inDevContainer"
        },
        {
          "command": "warpengine.startDocker",
          "when": "!warpengine.inDevContainer"
        },
        {
          "command": "warpengine.startDevContainer",
          "when": "false"
        },
        {
          "command": "warpengine.stopDevContainer",
          "when": "false"
        },
        {
          "command": "warpengine.openUrl",
          "when": "false"
        },
        {
          "command": "warpengine.triggerPipeline",
          "when": "warpengine.isProject && warpengine.signedIn"
        },
        {
          "command": "warpengine.editSoftwareField",
          "when": "false"
        },
        {
          "command": "warpengine.showChecklist",
          "when": "false"
        },
        {
          "command": "warpengine.showStatistics",
          "when": "false"
        },
        {
          "command": "warpengine.refresh",
          "when": "warpengine.hasHost"
        },
        {
          "command": "warpengine.copyLink",
          "when": "false"
        },
        {
          "command": "warpengine.syncPushNow",
          "when": "false"
        },
        {
          "command": "warpengine.syncEditChannels",
          "when": "false"
        },
        {
          "command": "warpengine.syncCheck",
          "when": "false"
        },
        {
          "command": "warpengine.syncDisconnect",
          "when": "false"
        },
        {
          "command": "warpengine.addImage",
          "when": "false"
        },
        {
          "command": "warpengine.imageMakeDefault",
          "when": "false"
        },
        {
          "command": "warpengine.imageMoveUp",
          "when": "false"
        },
        {
          "command": "warpengine.imageMoveDown",
          "when": "false"
        },
        {
          "command": "warpengine.imageRemove",
          "when": "false"
        },
        {
          "command": "warpengine.syncTo",
          "when": "warpengine.localEngine"
        },
        {
          "command": "warpengine.setupLocalCi",
          "when": "warpengine.localEngine"
        },
        {
          "command": "warpengine.deleteSoftware",
          "when": "false"
        },
        {
          "command": "warpengine.deleteRelease",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "warpengine.editMetadata",
          "when": "resourceFilename == metadata.json",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "warpengine",
          "title": "%viewsContainer.warpengine%",
          "icon": "media/warp.svg"
        }
      ]
    },
    "views": {
      "warpengine": [
        {
          "id": "warpengine.project",
          "name": "%view.project%"
        },
        {
          "id": "warpengine.catalog",
          "name": "%view.catalog%",
          "visibility": "collapsed"
        },
        {
          "id": "warpengine.servers",
          "name": "%view.servers%",
          "visibility": "collapsed"
        },
        {
          "id": "warpengine.health",
          "name": "%view.health%",
          "visibility": "collapsed"
        },
        {
          "id": "warpengine.sync",
          "name": "%view.sync%",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "warpengine.project",
        "contents": "%welcome.project%"
      },
      {
        "view": "warpengine.catalog",
        "contents": "%welcome.catalog.host%",
        "when": "!warpengine.hasHost"
      },
      {
        "view": "warpengine.catalog",
        "contents": "%welcome.catalog.signIn%",
        "when": "warpengine.hasHost && !warpengine.signedIn"
      },
      {
        "view": "warpengine.sync",
        "contents": "%welcome.sync.local%",
        "when": "!warpengine.localEngine"
      },
      {
        "view": "warpengine.sync",
        "contents": "%welcome.sync.pair%",
        "when": "warpengine.localEngine && !warpengine.syncing"
      }
    ],
    "authentication": [
      {
        "id": "warpengine",
        "label": "WarpEngine"
      }
    ],
    "customEditors": [
      {
        "viewType": "warpengine.metadata",
        "displayName": "%customEditor.metadata%",
        "selector": [
          {
            "filenamePattern": "metadata.json"
          }
        ],
        "priority": "option"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "metadata.json",
        "url": "warpengine-schema://current/metadata.schema.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "warpengine",
        "properties": {
          "target": {
            "type": "string",
            "description": "%task.target%"
          },
          "ci": {
            "type": "boolean",
            "description": "%task.ci%"
          },
          "host": {
            "type": "boolean",
            "description": "%task.host%"
          },
          "action": {
            "type": "string",
            "enum": [
              "play",
              "devImage"
            ],
            "enumDescriptions": [
              "%task.action.play%",
              "%task.action.devImage%"
            ],
            "description": "%task.action%"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "warp-acme",
        "owner": "warpengine",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(Error|Warning|Serious error) - File ([^,]+), line (\\d+) \\([^)]*\\): (.*)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "message": 4
        }
      },
      {
        "name": "warp-cc65",
        "owner": "warpengine",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^([^(\\s]+)\\((\\d+)\\): (Error|Warning): (.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      },
      {
        "name": "warp-gcc",
        "owner": "warpengine",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^([^:\\s][^:]*):(\\d+):(\\d+):\\s+(?:(error|warning|note):\\s+)?(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      {
        "name": "warp-lua",
        "owner": "warpengine",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(?:lua\\S*:\\s+)?([^:\\s]+\\.lua):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      }
    ],
    "configuration": {
      "title": "WarpEngine",
      "properties": {
        "warpengine.url": {
          "type": "string",
          "default": "",
          "format": "uri",
          "markdownDescription": "%config.url%"
        },
        "warpengine.hosts": {
          "type": "array",
          "description": "%config.hosts%",
          "items": {
            "type": "object",
            "required": [
              "name",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "default": []
        },
        "warpengine.localPort": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "markdownDescription": "%config.localPort%"
        },
        "warpengine.localData": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.localData%"
        },
        "warpengine.checkOnSave": {
          "type": "boolean",
          "description": "%config.checkOnSave%",
          "default": true
        },
        "warpengine.docker": {
          "type": "string",
          "description": "%config.docker%",
          "default": "docker"
        },
        "warpengine.defaultLocation": {
          "type": "string",
          "description": "%config.defaultLocation%",
          "default": ""
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "warpengine",
        "label": "%mcp.label%"
      }
    ]
  },
  "scripts": {
